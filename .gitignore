# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Production
*.production

# Env files (NEVER commit real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Logs (only root-level "logs" — not src/app/logs which is a route)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
/logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase local
supabase/.branches
supabase/.temp

# Docker
docker-compose.override.yml

# Misc
.cache/
.turbo/

# local-only memory MCP mount (machine-specific; do not commit)
.mcp.json

# Any filled-in environment file, under any name. `.env` alone matched only `.env`,
# so renaming a copy to `.env.old-keycloak` was enough to commit real passwords
# (document-vault, 2026-07-31). The example template stays committable.
.env*
!.env.example
