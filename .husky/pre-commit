#!/usr/bin/env sh
# Fast pre-commit gate: format + lint ONLY the staged files.
# Deliberately does NOT run a repo-wide typecheck/test — those are slow and would
# hard-block commits on pre-existing/legacy errors. CI enforces typecheck + tests
# (warn-then-ratchet, see TOOLING_STANDARD.md).
# `npx` is package-manager-agnostic (resolves ./node_modules/.bin under npm AND pnpm).
npx --no-install lint-staged
