# SDM LLM Gateway — environment variables
# Copy to .env.local for dev, set in Coolify env for production.
# NEVER commit a real .env file.

# -------- Admin auth (NextAuth + Google OAuth) --------
# Comma-separated list of Google emails allowed into the admin UI.
# FAILS CLOSED: unset or empty denies every sign-in.
ADMIN_EMAILS=

# The LOGIN credential — the shared OAuth client from the dedicated "SDM Login"
# Google Cloud project, used by every Sand Dollar app so one Google account signs
# into all of them. Identity scopes only.
#
# Named AUTH_GOOGLE_* rather than GOOGLE_CLIENT_ID because fleet-wide that name means
# an app's DATA-access credential (Gmail/Drive/Photos) from a project with sensitive
# scopes. This gateway has no data credential, but it uses the same name as everywhere
# else — one name meaning two things is exactly how the two got entangled in Ops-Hub.
#
# Redirect URI registered for this app:
#   https://llm.sanddollarmanagementllc.com/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# LEGACY, migration only. Login falls back to these (with a warning) when AUTH_GOOGLE_*
# is unset, so this deploy never loses sign-in mid-migration. Remove both once
# AUTH_GOOGLE_CLIENT_ID is confirmed set in Coolify.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth session signing key. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of this gateway (used by NextAuth for redirect URIs).
NEXTAUTH_URL=https://llm.sanddollarmanagementllc.com

# -------- Database (Postgres container in Coolify) --------
# Inside the Coolify network, the Postgres container is reachable at its hostname.
DATABASE_URL=postgresql://gateway_user:CHANGE_ME@gateway-db:5432/sdm_llm_gateway

# -------- Encryption --------
# 32-byte hex string used to encrypt provider credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Back this up to 1Password. Losing it = losing access to every stored credential.
GATEWAY_ENCRYPTION_KEY=

# -------- LiteLLM proxy (internal Docker network only) --------
LITELLM_INTERNAL_URL=http://gateway-litellm:4000
# Master key the wrapper uses to authenticate against LiteLLM.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=

# -------- Public URL --------
NEXT_PUBLIC_GATEWAY_URL=https://llm.sanddollarmanagementllc.com

# -------- Anthropic Max plan OAuth token (D-020 / Path A) --------
# Generated locally by running `claude setup-token` on a workstation that has
# the claude CLI installed. Token starts with sk-ant-oat01-... and is valid
# for one year.  The Docker entrypoint script writes this into
# /app/.claude/.credentials.json at container start so the claude CLI binary
# inside the runner image can pick it up.
ANTHROPIC_OAUTH_TOKEN=

# -------- Node env --------
NODE_ENV=production
