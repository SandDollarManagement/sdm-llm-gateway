{
  "name": "sdm-llm-gateway",
  "version": "0.6.0",
  "private": true,
  "description": "Multi-provider LLM gateway with Anthropic OAuth-first routing",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node scripts/migrate.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "knip": "knip",
    "prepare": "husky || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "clsx": "2.1.0",
    "lucide-react": "0.383.0",
    "next": "14.2.0",
    "next-auth": "4.24.7",
    "pg": "8.12.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "recharts": "2.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "10.4.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "postcss": "8.4.0",
    "prettier": "^3.9.4",
    "tailwindcss": "3.4.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
